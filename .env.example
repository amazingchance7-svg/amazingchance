POSTGRES_DB=amazing_chance
POSTGRES_USER=amazing_chance
POSTGRES_PASSWORD=change_me

# Runtime application identity: least-privilege only.
DATABASE_URL=postgresql://amazing_chance_runtime:change_me@localhost:5432/amazing_chance?schema=public

# SEC-026 isolated runtime database identities.
# Each login must receive membership only in its matching NOLOGIN role.
PAYMENT_DATABASE_URL=postgresql://amazing_chance_payment_runtime:change_me@localhost:5432/amazing_chance?schema=public
DRAW_DATABASE_URL=postgresql://amazing_chance_draw_runtime:change_me@localhost:5432/amazing_chance?schema=public
CLAIM_DATABASE_URL=postgresql://amazing_chance_claim_runtime:change_me@localhost:5432/amazing_chance?schema=public
PAYOUT_DATABASE_URL=postgresql://amazing_chance_payout_runtime:change_me@localhost:5432/amazing_chance?schema=public

# Migration/DDL identity: provide only to migration tooling/CI, never to the running API.
MIGRATION_DATABASE_URL=postgresql://amazing_chance_admin:change_me@localhost:5432/amazing_chance?schema=public

# Local development may use redis://. Production requires rediss://.
REDIS_URL=redis://localhost:6379

API_PORT=3001
WEB_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001

JWT_ACCESS_SECRET=replace_with_at_least_32_random_bytes_access
JWT_REFRESH_SECRET=replace_with_a_different_32_random_bytes_refresh
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

SNAPSHOT_OWNER_SECRET=replace_with_at_least_32_random_bytes

# Canonical base64 encoding of exactly 32 random bytes.
MFA_ENCRYPTION_KEY=

# Production email transport.
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=noreply@amazing-chance.com
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
