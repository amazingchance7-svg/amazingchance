{
    "name": "@amazing-chance/api",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "nest start --watch",
        "build": "nest build",
        "start": "node dist/main.js",
        "lint": "eslint .",
        "typecheck": "tsc --noEmit",
        "prisma:generate": "prisma generate",
        "prisma:migrate": "pnpm run prisma:migrate:dev",
        "prisma:studio": "prisma studio",
        "prisma:migrate:dev": "prisma migrate dev",
        "prisma:migrate:deploy": "prisma migrate deploy",
        "prisma:migrate:status": "prisma migrate status",
        "lint:fix": "eslint . --fix",
        "test": "pnpm run test:unit && pnpm run test:integration",
        "test:unit": "jest --config test/jest.unit.config.cjs --runInBand",
        "test:integration": "node test/run-integration.cjs",
        "test:coverage": "jest --config test/jest.unit.config.cjs --coverage --runInBand",
        "test:watch": "jest --config test/jest.unit.config.cjs --watch",
        "test:integration:db": "jest --config test/jest.integration.config.cjs --runInBand"
    },
    "dependencies": {
        "@nestjs/common": "11.1.28",
        "@nestjs/config": "4.0.2",
        "@nestjs/core": "11.1.28",
        "@nestjs/jwt": "11.0.1",
        "@nestjs/passport": "11.0.5",
        "@nestjs/platform-express": "11.1.28",
        "@nestjs/swagger": "^11.4.6",
        "@prisma/adapter-pg": "7.9.0",
        "@prisma/client": "7.9.0",
        "argon2": "0.44.0",
        "class-transformer": "0.5.1",
        "class-validator": "0.14.2",
        "dotenv": "^17.4.2",
        "passport": "0.7.0",
        "passport-jwt": "4.0.1",
        "pg": "^8.22.0",
        "reflect-metadata": "0.2.2",
        "rxjs": "7.8.2",
        "swagger-ui-express": "^5.0.1"
    },
    "devDependencies": {
        "@eslint/js": "9.34.0",
        "@nestjs/cli": "11.0.10",
        "@nestjs/schematics": "11.0.7",
        "@nestjs/testing": "11.1.28",
        "@types/express": "5.0.3",
        "@types/jest": "29.5.14",
        "@types/node": "24.3.0",
        "@types/passport-jwt": "4.0.1",
        "@types/pg": "^8.20.0",
        "@types/supertest": "6.0.3",
        "eslint": "9.34.0",
        "globals": "16.3.0",
        "jest": "29.7.0",
        "prisma": "7.9.0",
        "supertest": "7.1.4",
        "ts-jest": "29.4.5",
        "typescript": "5.9.3",
        "typescript-eslint": "8.41.0"
    }
}
