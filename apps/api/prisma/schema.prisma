generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  CLOSED
}

enum UserTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum DrawType {
  WEEKLY
  ANNUAL
}

enum DrawStatus {
  SCHEDULED
  SALES_OPEN
  SALES_CLOSED
  SNAPSHOT_BUILDING
  SNAPSHOT_FINALIZED
  RANDOMNESS_PENDING
  RANDOMNESS_VERIFIED
  WINNER_SELECTION_PENDING
  COMPLETED
  PUBLISHED
  MANUAL_REVIEW
  FAILED
  CANCELLED
}

enum PurchaseStatus {
  CREATED
  PAYMENT_PENDING
  PAYMENT_CONFIRMED
  TICKET_ALLOCATION_PENDING
  COMPLETED
  PAYMENT_FAILED
  EXPIRED
  CANCELLED
  MANUAL_REVIEW
  REFUND_PENDING
  REFUNDED
}

enum PaymentStatus {
  CREATED
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
  MANUAL_REVIEW
  REFUND_PENDING
  PARTIALLY_REFUNDED
  REFUNDED
}

enum PaymentAttemptStatus {
  CREATED
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum WebhookStatus {
  RECEIVED
  VERIFIED
  PROCESSED
  DUPLICATE
  REJECTED
  FAILED
}

enum TicketStatus {
  ACTIVE
  VOIDED_BY_REFUND
}

enum NotificationOutboxType {
  PURCHASE_COMPLETED
  DRAW_WINNER
  DRAW_PUBLISHED
}

enum NotificationOutboxStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

enum SnapshotStatus {
  BUILDING
  FINALIZED
}

enum RandomnessStatus {
  CREATED
  REQUESTED
  RECEIVED
  VERIFIED
  REJECTED
  FAILED
}

enum PrizeStatus {
  CREATED
  CLAIM_PENDING
  APPROVED
  PAYOUT_PENDING
  PAID
  WITHHELD
  CANCELLED
}

enum PayoutStatus {
  CREATED
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
  MANUAL_REVIEW
}

enum LedgerTransactionType {
  PAYMENT_CONFIRMED
  PAYMENT_ALLOCATION
  PRIZE_RECOGNIZED
  PAYOUT_COMPLETED
  REFUND_COMPLETED
  ADJUSTMENT
}

enum LedgerAccountCode {
  PAYMENT_CLEARING
  CASH
  WEEKLY_JACKPOT
  ANNUAL_JACKPOT
  COMPANY_REVENUE
  PRIZE_PAYABLE
  PAYOUT_CLEARING
  REFUND_PAYABLE
}

enum LedgerSide {
  DEBIT
  CREDIT
}

enum AuditActorType {
  USER
  ADMIN
  SYSTEM
  PAYMENT_PROVIDER
  RANDOMNESS_PROVIDER
}

model User {
  id              String     @id @default(uuid()) @db.Uuid
  email           String     @unique
  passwordHash    String
  status          UserStatus @default(PENDING_VERIFICATION)
  emailVerifiedAt DateTime?  @db.Timestamptz(3)
  authVersion     Int        @default(1)
  createdAt       DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime   @updatedAt @db.Timestamptz(3)

  purchases     Purchase[]
  tickets       Ticket[]
  prizes        Prize[]
  payouts       Payout[]
  refreshTokens RefreshToken[]
  userTokens    UserToken[]
  mfaCredential MfaCredential?
  roles         UserRole[]     @relation("UserRoleUser")
  assignedRoles UserRole[]     @relation("UserRoleAssignedBy")

  @@index([status])
  @@map("users")
}

model MfaCredential {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @unique @db.Uuid
  encryptedSecret String
  encryptionIv    String
  authTag         String
  enabledAt       DateTime? @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([enabledAt])
  @@map("mfa_credentials")
}

model RefreshToken {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  tokenHash   String    @unique
  mfaVerified Boolean   @default(false)
  expiresAt   DateTime  @db.Timestamptz(3)
  revokedAt   DateTime? @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model LotteryDraw {
  id                String     @id @default(uuid()) @db.Uuid
  publicId          String     @unique
  type              DrawType
  status            DrawStatus @default(SCHEDULED)
  sequenceNumber    Int
  participationYear Int?
  salesOpenAt       DateTime?  @db.Timestamptz(3)
  salesCloseAt      DateTime?  @db.Timestamptz(3)
  scheduledDrawAt   DateTime   @db.Timestamptz(3)
  completedAt       DateTime?  @db.Timestamptz(3)
  publishedAt       DateTime?  @db.Timestamptz(3)
  currency          String     @default("USD") @db.Char(3)
  ticketPriceMinor  BigInt
  winnerCount       Int        @default(3)
  createdAt         DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime   @updatedAt @db.Timestamptz(3)

  purchases         Purchase[]
  tickets           Ticket[]
  ticketAllocations TicketAllocation[]
  ticketSequence    TicketSequence?
  snapshot          TicketSnapshot?
  randomnessRecords RandomnessEvidence[]
  winners           DrawWinner[]
  prizes            Prize[]

  @@unique([type, sequenceNumber])
  @@index([status, scheduledDrawAt])
  @@index([type, participationYear])
  @@map("lottery_draws")
}

model UserToken {
  id        String        @id @default(uuid()) @db.Uuid
  userId    String        @db.Uuid
  type      UserTokenType
  tokenHash String        @unique
  expiresAt DateTime      @db.Timestamptz(3)
  usedAt    DateTime?     @db.Timestamptz(3)
  createdAt DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt DateTime      @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, usedAt])
  @@index([expiresAt])
  @@map("user_tokens")
}

model Purchase {
  id                   String         @id @default(uuid()) @db.Uuid
  publicId             String         @unique
  userId               String         @db.Uuid
  drawId               String         @db.Uuid
  status               PurchaseStatus @default(CREATED)
  requestedTicketCount Int
  ticketPriceMinor     BigInt
  totalAmountMinor     BigInt
  currency             String         @db.Char(3)
  idempotencyKey       String         @unique
  expiresAt            DateTime?      @db.Timestamptz(3)
  paymentConfirmedAt   DateTime?      @db.Timestamptz(3)
  completedAt          DateTime?      @db.Timestamptz(3)
  createdAt            DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime       @updatedAt @db.Timestamptz(3)

  user             User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  draw             LotteryDraw          @relation(fields: [drawId], references: [id], onDelete: Restrict)
  payments         Payment[]
  tickets          Ticket[]
  ticketAllocation TicketAllocation?
  stateEvents      PurchaseStateEvent[]

  @@index([userId, createdAt])
  @@index([drawId, status])
  @@index([status, expiresAt])
  @@map("purchases")
}

model PurchaseStateEvent {
  id            String          @id @default(uuid()) @db.Uuid
  purchaseId    String          @db.Uuid
  fromStatus    PurchaseStatus?
  toStatus      PurchaseStatus
  cause         String
  source        AuditActorType
  correlationId String
  metadata      Json?
  sealedAt      DateTime?       @db.Timestamptz(3)
  createdAt     DateTime        @default(now()) @db.Timestamptz(3)

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Restrict)

  @@unique([purchaseId, correlationId, toStatus])
  @@index([purchaseId, createdAt])
  @@map("purchase_state_events")
}

model Payment {
  id                    String        @id @default(uuid()) @db.Uuid
  purchaseId            String        @db.Uuid
  provider              String
  providerTransactionId String?       @unique
  status                PaymentStatus @default(CREATED)
  amountMinor           BigInt
  currency              String        @db.Char(3)
  confirmedAt           DateTime?     @db.Timestamptz(3)
  failureCode           String?
  failureMessage        String?
  providerData          Json?
  createdAt             DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime      @updatedAt @db.Timestamptz(3)

  purchase Purchase         @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  attempts PaymentAttempt[]
  webhooks WebhookEvent[]

  @@index([purchaseId, status])
  @@index([provider, status])
  @@map("payments")
}

model PaymentAttempt {
  id                String               @id @default(uuid()) @db.Uuid
  paymentId         String               @db.Uuid
  attemptNumber     Int
  idempotencyKey    String               @unique
  providerSessionId String?              @unique
  status            PaymentAttemptStatus @default(CREATED)
  requestPayload    Json?
  responsePayload   Json?
  failureCode       String?
  failureMessage    String?
  startedAt         DateTime             @default(now()) @db.Timestamptz(3)
  finishedAt        DateTime?            @db.Timestamptz(3)

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@unique([paymentId, attemptNumber])
  @@index([paymentId, status])
  @@map("payment_attempts")
}

model WebhookEvent {
  id              String        @id @default(uuid()) @db.Uuid
  paymentId       String?       @db.Uuid
  provider        String
  providerEventId String
  eventType       String
  status          WebhookStatus @default(RECEIVED)
  signature       String?
  payloadHash     String
  payload         Json
  receivedAt      DateTime      @default(now()) @db.Timestamptz(3)
  processedAt     DateTime?     @db.Timestamptz(3)
  errorMessage    String?

  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@unique([provider, providerEventId])
  @@index([status, receivedAt])
  @@index([paymentId])
  @@map("webhook_events")
}

model TicketSequence {
  drawId     String   @id @db.Uuid
  nextNumber BigInt   @default(1)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  draw LotteryDraw @relation(fields: [drawId], references: [id], onDelete: Cascade)

  @@map("ticket_sequences")
}

model TicketAllocation {
  id            String   @id @default(uuid()) @db.Uuid
  purchaseId    String   @unique @db.Uuid
  drawId        String   @db.Uuid
  startNumber   BigInt
  endNumber     BigInt
  correlationId String
  createdAt     DateTime @default(now()) @db.Timestamptz(3)

  purchase Purchase    @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  draw     LotteryDraw @relation(fields: [drawId], references: [id], onDelete: Restrict)

  @@index([drawId, createdAt])
  @@index([correlationId])
  @@map("ticket_allocations")
}

model Ticket {
  id           String       @id @default(uuid()) @db.Uuid
  publicId     String       @unique
  userId       String       @db.Uuid
  purchaseId   String       @db.Uuid
  drawId       String       @db.Uuid
  numberInDraw BigInt
  status       TicketStatus @default(ACTIVE)
  issuedAt     DateTime     @default(now()) @db.Timestamptz(3)
  voidedAt     DateTime?    @db.Timestamptz(3)
  voidReason   String?

  user            User                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  purchase        Purchase              @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  draw            LotteryDraw           @relation(fields: [drawId], references: [id], onDelete: Restrict)
  snapshotEntries TicketSnapshotEntry[]
  winners         DrawWinner[]

  @@unique([drawId, numberInDraw])
  @@index([userId, issuedAt])
  @@index([purchaseId])
  @@index([drawId, status])
  @@map("tickets")
}

model TicketSnapshot {
  id              String         @id @default(uuid()) @db.Uuid
  drawId          String         @unique @db.Uuid
  status          SnapshotStatus @default(BUILDING)
  ticketCount     BigInt
  canonicalFormat String
  hashAlgorithm   String         @default("SHA-256")
  snapshotHash    String?        @unique
  merkleRoot      String?
  builtAt         DateTime?      @db.Timestamptz(3)
  finalizedAt     DateTime?      @db.Timestamptz(3)
  createdAt       DateTime       @default(now()) @db.Timestamptz(3)

  draw    LotteryDraw           @relation(fields: [drawId], references: [id], onDelete: Restrict)
  entries TicketSnapshotEntry[]

  @@index([status, createdAt])
  @@map("ticket_snapshots")
}

model TicketSnapshotEntry {
  id             String @id @default(uuid()) @db.Uuid
  snapshotId     String @db.Uuid
  ticketId       String @db.Uuid
  position       BigInt
  ticketPublicId String
  ownerPublicRef String

  snapshot TicketSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Restrict)
  ticket   Ticket         @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  winner   DrawWinner?

  @@unique([snapshotId, position])
  @@index([snapshotId, ticketPublicId])
  @@map("ticket_snapshot_entries")
}

model RandomnessEvidence {
  id                String           @id @default(uuid()) @db.Uuid
  drawId            String           @db.Uuid
  attemptNumber     Int
  provider          String           @default("RANDOM_ORG")
  status            RandomnessStatus @default(CREATED)
  idempotencyKey    String           @unique
  requestedMin      BigInt
  requestedMax      BigInt
  requestedCount    Int
  requestPayload    Json?
  responsePayload   Json?
  responseHash      String?
  providerSignature String?
  signatureVerified Boolean?
  randomPositions   Json?
  requestedAt       DateTime?        @db.Timestamptz(3)
  receivedAt        DateTime?        @db.Timestamptz(3)
  verifiedAt        DateTime?        @db.Timestamptz(3)
  failureMessage    String?
  createdAt         DateTime         @default(now()) @db.Timestamptz(3)

  draw LotteryDraw @relation(fields: [drawId], references: [id], onDelete: Restrict)

  @@unique([drawId, attemptNumber])
  @@index([drawId, status])
  @@map("randomness_evidence")
}

model DrawWinner {
  id              String   @id @default(uuid()) @db.Uuid
  drawId          String   @db.Uuid
  ticketId        String   @db.Uuid
  snapshotEntryId String   @unique @db.Uuid
  rank            Int
  randomPosition  BigInt
  createdAt       DateTime @default(now()) @db.Timestamptz(3)

  draw          LotteryDraw         @relation(fields: [drawId], references: [id], onDelete: Restrict)
  ticket        Ticket              @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  snapshotEntry TicketSnapshotEntry @relation(fields: [snapshotEntryId], references: [id], onDelete: Restrict)
  prize         Prize?

  @@unique([drawId, rank])
  @@unique([drawId, ticketId])
  @@unique([drawId, randomPosition])
  @@index([drawId])
  @@map("draw_winners")
}

model Prize {
  id          String      @id @default(uuid()) @db.Uuid
  drawId      String      @db.Uuid
  winnerId    String      @unique @db.Uuid
  userId      String      @db.Uuid
  rank        Int
  amountMinor BigInt
  currency    String      @db.Char(3)
  status      PrizeStatus @default(CREATED)
  approvedAt  DateTime?   @db.Timestamptz(3)
  paidAt      DateTime?   @db.Timestamptz(3)
  createdAt   DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime    @updatedAt @db.Timestamptz(3)

  draw    LotteryDraw @relation(fields: [drawId], references: [id], onDelete: Restrict)
  winner  DrawWinner  @relation(fields: [winnerId], references: [id], onDelete: Restrict)
  user    User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  payouts Payout[]

  @@unique([drawId, rank])
  @@index([userId, status])
  @@index([status, createdAt])
  @@map("prizes")
}

model Payout {
  id                    String       @id @default(uuid()) @db.Uuid
  prizeId               String       @db.Uuid
  userId                String       @db.Uuid
  status                PayoutStatus @default(CREATED)
  amountMinor           BigInt
  currency              String       @db.Char(3)
  idempotencyKey        String       @unique
  provider              String?
  providerTransactionId String?      @unique
  failureCode           String?
  failureMessage        String?
  createdAt             DateTime     @default(now()) @db.Timestamptz(3)
  processedAt           DateTime?    @db.Timestamptz(3)

  prize Prize @relation(fields: [prizeId], references: [id], onDelete: Restrict)
  user  User  @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([prizeId, status])
  @@index([userId, createdAt])
  @@map("payouts")
}

model AllocationRule {
  id                String    @id @default(uuid()) @db.Uuid
  version           Int       @unique
  weeklyJackpotBps  Int
  annualJackpotBps  Int
  companyRevenueBps Int
  effectiveFrom     DateTime  @db.Timestamptz(3)
  effectiveTo       DateTime? @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)

  @@index([effectiveFrom, effectiveTo])
  @@map("allocation_rules")
}

model LedgerTransaction {
  id             String                @id @default(uuid()) @db.Uuid
  type           LedgerTransactionType
  idempotencyKey String                @unique
  referenceType  String
  referenceId    String
  currency       String                @db.Char(3)
  description    String?
  metadata       Json?
  sealedAt       DateTime?             @db.Timestamptz(3)
  createdAt      DateTime              @default(now()) @db.Timestamptz(3)

  postings LedgerPosting[]

  @@index([referenceType, referenceId])
  @@index([type, createdAt])
  @@map("ledger_transactions")
}

model LedgerPosting {
  id            String            @id @default(uuid()) @db.Uuid
  transactionId String            @db.Uuid
  accountCode   LedgerAccountCode
  side          LedgerSide
  amountMinor   BigInt
  createdAt     DateTime          @default(now()) @db.Timestamptz(3)

  transaction LedgerTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)

  @@index([transactionId])
  @@index([accountCode, createdAt])
  @@map("ledger_postings")
}

model AuditLog {
  id            String         @id @default(uuid()) @db.Uuid
  actorType     AuditActorType
  actorId       String?
  action        String
  entityType    String
  entityId      String
  correlationId String
  requestId     String?
  ipAddress     String?
  previousState Json?
  newState      Json?
  metadata      Json?
  sealedAt      DateTime?      @db.Timestamptz(3)
  createdAt     DateTime       @default(now()) @db.Timestamptz(3)

  @@index([entityType, entityId, createdAt])
  @@index([actorType, actorId, createdAt])
  @@index([correlationId])
  @@map("audit_logs")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  name        String
  description String?
  isSystem    Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  description String?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  roles RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId           String   @db.Uuid
  roleId           String   @db.Uuid
  assignedAt       DateTime @default(now()) @db.Timestamptz(3)
  assignedByUserId String?  @db.Uuid

  user           User  @relation("UserRoleUser", fields: [userId], references: [id], onDelete: Cascade)
  role           Role  @relation(fields: [roleId], references: [id], onDelete: Restrict)
  assignedByUser User? @relation("UserRoleAssignedBy", fields: [assignedByUserId], references: [id], onDelete: SetNull)

  @@id([userId, roleId])
  @@index([roleId])
  @@index([assignedByUserId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String @db.Uuid
  permissionId String @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model NotificationOutbox {
  id             String                   @id @default(uuid()) @db.Uuid
  type           NotificationOutboxType
  status         NotificationOutboxStatus @default(PENDING)
  idempotencyKey String                   @unique
  recipientEmail String
  payload        Json
  attempts       Int                      @default(0)
  nextAttemptAt  DateTime                 @default(now()) @db.Timestamptz(3)
  lockedAt       DateTime?                @db.Timestamptz(3)
  sentAt         DateTime?                @db.Timestamptz(3)
  lastError      String?
  createdAt      DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime                 @updatedAt @db.Timestamptz(3)

  @@index([status, nextAttemptAt])
  @@index([lockedAt])
  @@map("notification_outbox")
}
