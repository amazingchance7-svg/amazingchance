generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"

}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  CLOSED
}

enum DrawStatus {
  DRAFT
  SCHEDULED
  OPEN
  SALES_CLOSED
  DRAWING
  COMPLETED
  CANCELLED
  ARCHIVED
}

enum PurchaseStatus {
  CREATED
  PAYMENT_PENDING
  PAYMENT_CONFIRMED
  TICKET_ALLOCATION_PENDING
  COMPLETED
  PAYMENT_FAILED
  EXPIRED
  CANCELLED
  MANUAL_REVIEW
  REFUND_PENDING
  REFUNDED
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  FAILED
  CANCELLED
  REFUNDED
}

enum AllocationType {
  WEEKLY_JACKPOT
  COMPANY_REVENUE
  ANNUAL_JACKPOT
}

enum AuditActorType {
  USER
  ADMIN
  SYSTEM
  PAYMENT_PROVIDER
}

model User {
  id              String     @id @default(uuid()) @db.Uuid
  email           String     @unique
  passwordHash    String
  status          UserStatus @default(PENDING_VERIFICATION)
  emailVerifiedAt DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  purchases       Purchase[]
  tickets         Ticket[]
  auditLogs       AuditLog[]

  @@map("users")
}

model Draw {
  id              String     @id @default(uuid()) @db.Uuid
  code            String     @unique
  title           String
  status          DrawStatus @default(DRAFT)
  ticketPrice     Decimal    @db.Decimal(12, 2)
  currency        String     @default("USD") @db.VarChar(3)
  salesOpenAt     DateTime?
  salesCloseAt    DateTime?
  drawAt          DateTime?
  completedAt     DateTime?
  cancelledAt     DateTime?
  archivedAt      DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  purchases       Purchase[]
  tickets         Ticket[]

  @@index([status])
  @@index([salesOpenAt])
  @@index([salesCloseAt])
  @@map("draws")
}

model Purchase {
  id                String         @id @default(uuid()) @db.Uuid
  userId            String         @db.Uuid
  drawId            String         @db.Uuid
  status            PurchaseStatus @default(CREATED)
  ticketQuantity    Int
  ticketPrice       Decimal        @db.Decimal(12, 2)
  totalAmount       Decimal        @db.Decimal(12, 2)
  currency          String         @default("USD") @db.VarChar(3)
  paymentProvider   String?
  expiresAt         DateTime?
  completedAt       DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  user              User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  draw              Draw           @relation(fields: [drawId], references: [id], onDelete: Restrict)
  payments          Payment[]
  tickets           Ticket[]
  allocations       AllocationEntry[]

  @@index([userId])
  @@index([drawId])
  @@index([status])
  @@map("purchases")
}

model Payment {
  id                    String        @id @default(uuid()) @db.Uuid
  purchaseId            String        @db.Uuid
  provider              String
  providerTransactionId String        @unique
  amount                Decimal       @db.Decimal(12, 2)
  currency              String        @db.VarChar(3)
  status                PaymentStatus @default(PENDING)
  confirmedAt           DateTime?
  failedAt              DateTime?
  refundedAt            DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  purchase              Purchase      @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  allocations           AllocationEntry[]

  @@index([purchaseId])
  @@index([status])
  @@map("payments")
}

model Ticket {
  id                 String   @id @default(uuid()) @db.Uuid
  ticketNumber       BigInt   @unique
  userId             String   @db.Uuid
  drawId             String   @db.Uuid
  purchaseId         String   @db.Uuid
  annualDrawEligible Boolean  @default(true)
  createdAt          DateTime @default(now())

  user               User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  draw               Draw     @relation(fields: [drawId], references: [id], onDelete: Restrict)
  purchase           Purchase @relation(fields: [purchaseId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([drawId])
  @@index([purchaseId])
  @@map("tickets")
}

model AllocationEntry {
  id             String         @id @default(uuid()) @db.Uuid
  purchaseId     String         @db.Uuid
  paymentId      String         @db.Uuid
  type           AllocationType
  percentage     Decimal        @db.Decimal(5, 2)
  amount         Decimal        @db.Decimal(12, 2)
  currency       String         @db.VarChar(3)
  ticketCount    Int
  createdAt      DateTime       @default(now())

  purchase       Purchase       @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  payment        Payment        @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@unique([paymentId, type])
  @@index([purchaseId])
  @@map("allocation_entries")
}

model AuditLog {
  id             String         @id @default(uuid()) @db.Uuid
  userId         String?        @db.Uuid
  actorType      AuditActorType
  actorId        String?
  action         String
  entityType     String
  entityId       String
  previousState  Json?
  newState       Json?
  metadata       Json?
  correlationId  String?
  createdAt      DateTime       @default(now())

  user           User?          @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([correlationId])
  @@index([createdAt])
  @@map("audit_logs")
}
