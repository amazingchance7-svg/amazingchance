+export interface ApiSuccessResponse<T> {
+  success: true;
+  data: T;
+  timestamp: string;
+  path: string;
+}
+
+export interface ApiErrorResponse {
+  success: false;
+  statusCode: number;
+  message: string | string[];
+  error?: string;
+  timestamp: string;
+  path: string;
+}
